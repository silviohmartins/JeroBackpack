<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>jerobackpack</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Library</OutputType>
		<Version>4.0.0</Version>
		<!-- The two lines below will set the output path for the binaries -->
		<OutputPath>bin\$(Configuration)\$(ProjectName)\$(AssemblyName)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="SPTushonka.Common" Version="4.1.6" />
		<PackageReference Include="SPTushonka.DI" Version="4.1.6" />
		<PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
		<PackageReference Include="SPTushonka.Server.Web" Version="4.1.6" />
	</ItemGroup>

</Project>